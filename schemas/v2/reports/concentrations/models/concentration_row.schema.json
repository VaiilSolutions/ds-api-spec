{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Report Row",
  "type": "object",
  "properties": {
    "label": {
      "type": "string",
      "description": "Row label"
    },
    "values": {
      "type": "array",
      "description": "Values for each column in order matching headers"
    }
  },
  "required": ["label", "values"]
}
