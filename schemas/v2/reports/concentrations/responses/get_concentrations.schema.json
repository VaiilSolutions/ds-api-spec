{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "allOf": [
    { "$ref": "../../../common/api_response.schema.json" },
    {
      "type": "object",
      "properties": {
        "data": {
          "type": "object",
          "properties": {
            "headers": {
              "type": "array",
              "items": { "type": "string" },
              "description": "Column headers"
            },
            "rows": {
              "type": "object",
              "additionalProperties": {
                "type": "array",
                "items": { "$ref": "../models/concentration_row.schema.json" }
              },
              "description": "Rows grouped by category"
            }
          },
          "required": ["headers", "rows"]
        }
      },
      "required": ["data"]
    }
  ]
}
