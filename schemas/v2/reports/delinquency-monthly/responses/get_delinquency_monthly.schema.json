{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "allOf": [
    { "$ref": "../../../common/api_response.schema.json" },
    {
      "type": "object",
      "properties": {
        "data": {
          "type": "object",
          "properties": {
            "headers": {
              "type": "array",
              "items": { "type": "string" },
              "description": "Month labels in chronological order"
            },
            "rows": {
              "type": "object",
              "properties": {
                "delinquency_balances": {
                  "type": "array",
                  "items": { "$ref": "../models/delinquency_row.schema.json" },
                  "description": "Balance rows (categories + DQ Balance + DQ Rate + Total Loans)"
                },
                "delinquency_counts": {
                  "type": "array",
                  "items": { "$ref": "../models/delinquency_row.schema.json" },
                  "description": "Count rows (categories + DQ Count)"
                }
              },
              "required": ["delinquency_balances", "delinquency_counts"]
            }
          },
          "required": ["headers", "rows"]
        }
      },
      "required": ["data"]
    }
  ]
}
